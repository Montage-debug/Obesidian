# =============== Obsidian 配置 ===============
# 完全排除所有 Obsidian 内部文件和配置
.obsidian/
.obsidian.*
.trash/
.sync/
.cache/
.temp/
*.tmp
.session

# =============== 系统文件 ===============
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*~
ehthumbs.db
Icon?

# =============== 临时和备份文件 ===============
*.bak
*.backup
*.old
*-backup.md
archive/
backup/
tmp/
temp/

# =============== IDE/编辑器文件 ===============
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# =============== 可选：媒体文件 ===============
# *.mp4
# *.mov
# *.avi
# *.mp3

# =============== 大型二进制文件（>50MB，超 GitHub 限制） ===============
# 系统镜像 / 压缩包
*.7z
*.img
*.tar.bz2
*.tar.gz
*.iso

# AI / 深度学习模型
*.pt
*.pth
*.onnx
*.enc

# 语音模型特定文件
*.far

# 安装包
*.deb
*.rpm

# 编译产物 / 共享库
*.so
*.so.*
*.a

# IDE 数据库
browse.vc.db

# Python 虚拟环境（绝对不应入库）
.venv/
venv/
env/
__pycache__/

# Ignore OpenVINO binary model files
**/openvino_models/**/*.bin
